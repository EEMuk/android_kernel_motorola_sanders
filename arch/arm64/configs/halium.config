# Halium 11 / Ubuntu Touch 24.04 requirements for sanders (3.18).
# Merged on top of sanders_defconfig:
#   make sanders_defconfig halium.config
# Based on the santoni (3.18, msm8937) and addison (3.18, msm8953) ports.

CONFIG_LOCALVERSION="-halium"

# --- initramfs / udev / systemd ---
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_CHECKPOINT_RESTORE=y

# --- namespaces for the LXC Android container ---
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y

# --- cgroups ---
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
# Realtime group scheduling breaks systemd's cgroup placement
# CONFIG_RT_GROUP_SCHED is not set

# --- LXC networking ---
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_VLAN_8021Q=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
# Ubuntu users are not in Android's inet group
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- AppArmor (apparmor3 backport) as the default LSM ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY="apparmor"
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_YAMA=y
CONFIG_AUDIT=y

# --- console ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_FB_VIRTUAL=y

# --- filesystems ---
CONFIG_OVERLAY_FS=y
CONFIG_NLS_UTF8=y

# --- firmware: no ueventd, load straight from the paths in firmware_class.c ---
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set

# --- memory: no Android lmkd in Ubuntu Touch ---
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set

# --- Bluetooth profiles + vhci for bluebinder ---
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y

# --- touch: hbtp input shows a stray cursor on Lomiri (santoni) ---
# CONFIG_INPUT_HBTP_INPUT is not set
